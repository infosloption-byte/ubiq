APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Box-wide ceiling on concurrent Ubiq sandboxes, independent of any single
# user's own plan limit. Default of 3 matches the capacity analysis for a
# c5a.xlarge shared with Voxora — see PLAN_SYSTEM_TASKS.md Phase B3e.
SANDBOX_GLOBAL_CONCURRENT_LIMIT=3

# PayPal Subscriptions — see PayPalService/PayPalController.
# plan_id below is only used as a legacy fallback; as of Phase C4, the
# actual plan is resolved by matching the subscription's plan_id against
# plans.paypal_plan_id in the database (set via the admin endpoints, B5),
# not this single env var.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# GitHub OAuth (F3, PLAN_SYSTEM_TASKS.md Phase F) — replaces pasted
# Personal Access Tokens for Source Control, and powers the repo picker
# in CreateProjectDialog.tsx (F3e). Register an OAuth App at
# https://github.com/settings/developers with its callback URL set to
# GITHUB_REDIRECT_URI below (or the services.php default if unset).
# GITHUB_CLIENT_ID/SECRET have no fallback default — if either is
# missing, GithubOAuthController::connect() now fails with a clear
# 'github_not_configured' error instead of silently sending the
# browser to a GitHub 404 (see that method's own comment).
# If you add these to an already-running server, remember
# `php artisan config:cache` (if ever run) caches the OLD values —
# `php artisan config:clear` or a full container restart, not just
# editing .env, or the new values won't take effect.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.ubiq-editor.space/api/v1/auth/github/callback
